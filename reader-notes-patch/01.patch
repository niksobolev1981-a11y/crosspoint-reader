   updateBookmarkFlag();
 }
 
+void EpubReaderActivity::startAddNote(const bool reopenMenuOnCancel) {
+  if (!section || !epub || pendingNoteValid) return;
+
+  int currentPage = 0;
+  int pageCount = 0;
+  {
+    RenderLock lock;
+    currentPage = section->currentPage;
+    pageCount = section->estimatedTotalPages();
+  }
+
+  const SavedProgressPosition progress = ProgressMapper::toSavedProgress(epub, getCurrentPosition());
+  pendingNote = NoteEntry{};
+  pendingNote.percentage = progress.percentage;
+  pendingNote.xpath = progress.xpath;
+  pendingNote.computedSpineIndex = currentSpineIndex;
+  pendingNote.computedChapterPageCount = static_cast<uint16_t>(std::max(0, pageCount));
+  pendingNote.computedChapterProgress = static_cast<uint16_t>(std::max(0, currentPage));
+  const std::optional<uint32_t> offset =
+      currentPageVisibleOffset.has_value()
+          ? currentPageVisibleOffset
+          : (currentPage >= 0 && currentPage < section->pageCount)
+                ? section->getVisibleTextOffsetForPage(static_cast<uint16_t>(currentPage))
+                : std::nullopt;
+  if (offset.has_value()) {
+    pendingNote.visibleTextOffset = *offset;
+    pendingNote.hasVisibleTextOffset = true;
+  }
+  pendingNoteValid = true;
+
+  auto keyboard = makeUniqueNoThrow<KeyboardEntryActivity>(renderer, mappedInput, tr(STR_ADD_NOTE), "",
+                                                            NoteEntry::MAX_TEXT_LENGTH, InputType::Text);
+  if (!keyboard) {
+    LOG_ERR("NTE", "OOM: add-note keyboard");
+    pendingNoteValid = false;
+    return;
+  }
+
+  startActivityForResult(std::move(keyboard), [this, reopenMenuOnCancel](const ActivityResult& result) {
+    if (!pendingNoteValid) return;
+    if (result.isCancelled) {
+      pendingNoteValid = false;
+      if (reopenMenuOnCancel)
+        openReaderMenu();
+      else
+        requestUpdate();
+      return;
+    }
+
+    pendingNote.text = std::get<KeyboardResult>(result.data).text;
+    if (!pendingNote.text.empty()) {
+      std::vector<NoteEntry> notes;
+      NoteFile::load(epub->getPath(), notes);
+      // Newest first, matching the quick-note workflow: the note just written is
+      // immediately visible at the top of the list.
+      notes.insert(notes.begin(), std::move(pendingNote));
+      if (!NoteFile::save(epub->getPath(), notes)) LOG_ERR("NTE", "Failed to save note");
+    }
+    pendingNote = NoteEntry{};
+    pendingNoteValid = false;
+    requestUpdate();
+  });
+}
