diff --git a/src/util/NoteFile.cpp b/src/util/NoteFile.cpp
new file mode 100644
index 0000000..56630e1
--- /dev/null
+++ b/src/util/NoteFile.cpp
@@ -0,0 +1,63 @@
+#include "NoteFile.h"
+
+#include <ArduinoJson.h>
+#include <HalStorage.h>
+#include <Logging.h>
+#include <PersistableStore.h>
+
+#include "NoteUtil.h"
+
+bool NoteFile::load(const std::string& bookPath, std::vector<NoteEntry>& notes) {
+  notes.clear();
+
+  const std::string path = NoteUtil::getNotePath(bookPath);
+  JsonDocument doc;
+  if (!PersistableStoreBase::readDocFromFile(path.c_str(), doc)) return false;
+
+  JsonArray arr = doc["notes"].as<JsonArray>();
+  notes.reserve(arr.size());
+  for (JsonObject obj : arr) {
+    notes.emplace_back();
+    auto& note = notes.back();
+    note.text = obj["text"] | "";
+    if (note.text.size() > NoteEntry::MAX_TEXT_LENGTH) note.text.resize(NoteEntry::MAX_TEXT_LENGTH);
+    note.xpath = obj["xpath"] | "";
+    note.percentage = obj["percentage"] | static_cast<float>(0);
+    note.computedSpineIndex = obj["si"] | static_cast<uint16_t>(0);
+    note.computedChapterPageCount = obj["pc"] | static_cast<uint16_t>(0);
+    note.computedChapterProgress = obj["pp"] | static_cast<uint16_t>(0);
+    if (!obj["vo"].isNull()) {
+      note.visibleTextOffset = obj["vo"] | static_cast<uint32_t>(0);
+      note.hasVisibleTextOffset = true;
+    }
+  }
+
+  LOG_DBG("NTE", "Loaded %zu notes from file", notes.size());
+  return true;
+}
+
+bool NoteFile::save(const std::string& bookPath, const std::vector<NoteEntry>& notes) {
+  for (const auto& note : notes) {
+    if (note.text.size() > NoteEntry::MAX_TEXT_LENGTH) {
+      LOG_ERR("NTE", "Note text exceeds %zu bytes", NoteEntry::MAX_TEXT_LENGTH);
+      return false;
+    }
+  }
+
+  JsonDocument doc;
+  JsonArray arr = doc["notes"].to<JsonArray>();
+  for (const auto& note : notes) {
+    JsonObject obj = arr.add<JsonObject>();
+    obj["text"] = note.text;
+    obj["xpath"] = note.xpath;
+    obj["percentage"] = note.percentage;
+    obj["si"] = note.computedSpineIndex;
+    obj["pc"] = note.computedChapterPageCount;
+    obj["pp"] = note.computedChapterProgress;
+    if (note.hasVisibleTextOffset) obj["vo"] = note.visibleTextOffset;
+  }
+
+  Storage.mkdir(NoteUtil::getNotesDir().c_str());
+  const std::string path = NoteUtil::getNotePath(bookPath);
+  return PersistableStoreBase::writeDocToFile(path.c_str(), doc);
+}
