diff --git a/src/util/NoteUtil.cpp b/src/util/NoteUtil.cpp
new file mode 100644
index 0000000..e22001e
--- /dev/null
+++ b/src/util/NoteUtil.cpp
@@ -0,0 +1,19 @@
+#include "NoteUtil.h"
+
+#include <algorithm>
+#include <string>
+
+std::string NoteUtil::getNotesDir() { return "/.crosspoint/notes/"; }
+
+std::string NoteUtil::getNotePath(const std::string& bookPath) {
+  // Mirror bookmark persistence: flatten the book path into a stable per-book
+  // filename while keeping notes separate from disposable EPUB caches.
+  std::string bookName = bookPath;
+  if (!bookName.empty() && bookName.front() == '/') bookName.erase(0, 1);
+  std::replace(bookName.begin(), bookName.end(), '/', '_');
+  std::replace(bookName.begin(), bookName.end(), '\\', '_');
+  const size_t lastDot = bookName.find_last_of('.');
+  if (lastDot != std::string::npos) bookName.erase(lastDot);
+  bookName += ".json";
+  return getNotesDir() + bookName;
+}
