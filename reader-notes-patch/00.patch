diff --git a/src/NoteEntry.h b/src/NoteEntry.h
new file mode 100644
index 0000000..d9aed91
--- /dev/null
+++ b/src/NoteEntry.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+// A reader note anchored to a precise EPUB position.
+struct NoteEntry {
+  // Bytes, not Unicode code points. KeyboardEntryActivity enforces the same
+  // byte-based limit, keeping persistence bounded on the embedded target.
+  static constexpr std::size_t MAX_TEXT_LENGTH = 512;
+
+  std::string text;
+  std::string xpath;
+  float percentage = 0.0f;
+
+  uint16_t computedSpineIndex = 0;
+  uint16_t computedChapterPageCount = 0;
+  uint16_t computedChapterProgress = 0;
+
+  bool hasVisibleTextOffset = false;
+  uint32_t visibleTextOffset = 0;
+};
